# =============================================
# Agent-RAG - 环境变量
# =============================================
# 复制本文件为 .env，填入你自己的值
# 支持任意 OpenAI 兼容的 LLM 服务端点

# LLM API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容端点（base_url，以 /v1 结尾）
# 示例：https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型名（按你选用的服务填写）
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Embedding 维度（必须与所选模型实际输出维度一致）
# 例如：text-embedding-3-small = 1536；多数国产服务 = 1024
EMBEDDING_DIMENSIONS=1536

# 向量库存储路径（相对项目根）
CHROMA_PERSIST_DIR=./data/chroma

# 服务端口
API_PORT=8000
UI_PORT=8501
